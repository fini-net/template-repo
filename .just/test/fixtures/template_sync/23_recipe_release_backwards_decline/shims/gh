#!/usr/bin/env bash
# Shim gh: serve the #436 order-check lookup a tag ABOVE the
# fixture's release; the gum shim declines, so the create is never
# reached (the fixture asserts its absence via the cancel line)
if [[ "$1 $2" == "release view" ]]; then
    printf 'v1.2.0\n'
    exit 0
fi
echo "gh-shim: $*"
