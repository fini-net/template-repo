#!/usr/bin/env bash
# Shim gh: serve the #436 order-check lookup (a latest tag below the
# fixture's release, so the forward path needs no confirmation), and
# record the create command so the fixture can assert a combined
# pre-release + build tag keeps its --prerelease flag (#379)
if [[ "$1 $2" == "release view" ]]; then
    printf 'v0.9.0\n'
    exit 0
fi
echo "gh-shim: $*"